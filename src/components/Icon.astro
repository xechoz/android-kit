---
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'github'
  | 'sun'
  | 'moon'
  | 'menu'
  | 'x'
  | 'copy'
  | 'check'
  | 'download'
  | 'search'
  | 'terminal'
  | 'package'
  | 'external-link'
  | 'chevron-down'
  | 'plus'
  | 'code'
  | 'book';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

