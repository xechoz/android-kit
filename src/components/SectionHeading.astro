---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div class="max-w-2xl">
    <p class="label">{eyebrow}</p>
    <h2 class="display mt-3 text-[clamp(2rem,4vw,3.4rem)]">{title}</h2>
    {lead && <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted">{lead}</p>}
  </div>
  <div class="shrink-0">
    <slot name="action" />
  </div>
</div>
