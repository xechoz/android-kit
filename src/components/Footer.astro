---
import Icon from '@/components/Icon.astro';
import { href, localizedHref } from '@/lib/routing';
import { site } from '@/lib/site';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const year = new Date().getFullYear();

const libraryLinks = [
  { slug: 'locale-kit', name: 'LocaleKit' },
  { slug: 'mvs', name: 'MVS' },
  { slug: 'loga', name: 'Loga' },
  { slug: 'service-center', name: 'ServiceCenter' },
  { slug: 'offline-web', name: 'Offline Web' },
];
---

<footer class="mt-24 border-t border-line">
  <div class="wrap grid gap-12 py-14 md:grid-cols-[1.3fr_0.7fr_0.7fr_0.7fr]">
    <div class="max-w-xs">
      <a href={localizedHref('/', lang)} class="mono text-[13px] tracking-[0.04em] lowercase">
        xechoz<span class="text-accent">/</span>android
      </a>
      <p class="mt-4 text-sm leading-relaxed text-muted">{copy.footer.note}</p>
      <p class="mt-4 font-mono text-[10.5px] uppercase tracking-[0.08em] text-muted">
        {copy.footer.built} · {copy.footer.skillsSpec}
      </p>
    </div>

    <div>
      <h2 class="label">{copy.footer.libraries}</h2>
      <ul class="mt-4 space-y-2.5">
        {
          libraryLinks.map((item) => (
            <li>
              <a
                href={localizedHref(`/components/${item.slug}/`, lang)}
                class="text-sm text-muted transition-colors hover:text-hover"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="label">{copy.footer.resources}</h2>
      <ul class="mt-4 space-y-2.5">
        <li>
          <a href={localizedHref('/skills/', lang)} class="text-sm text-muted transition-colors hover:text-hover">
            {copy.nav.skills}
          </a>
        </li>
        <li>
          <a href={localizedHref('/builder/', lang)} class="text-sm text-muted transition-colors hover:text-hover">
            {copy.nav.builder}
          </a>
        </li>
        <li>
          <a href={href('/registry.json')} class="text-sm text-muted transition-colors hover:text-hover">
            registry.json
          </a>
        </li>
        <li>
          <a href={href('/llms.txt')} class="text-sm text-muted transition-colors hover:text-hover">
            llms.txt
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="label">{copy.footer.elsewhere}</h2>
      <ul class="mt-4 space-y-2.5">
        <li>
          <a href={site.github} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-hover">
            GitHub <Icon name="arrow-up-right" size={12} />
          </a>
        </li>
        <li>
          <a href={site.blog} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-hover">
            {copy.footer.blog} <Icon name="arrow-up-right" size={12} />
          </a>
        </li>
        <li>
          <a href={site.repo} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-hover">
            {copy.footer.source} <Icon name="arrow-up-right" size={12} />
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="wrap flex flex-col gap-2 py-5 font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted sm:flex-row sm:items-center sm:justify-between">
      <span>© {year} xechoz</span>
      <span>{copy.footer.rights}</span>
    </div>
  </div>
</footer>
