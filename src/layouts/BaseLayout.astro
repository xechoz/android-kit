---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/styles/global.css';

import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { href, localizedHref, stripBase } from '@/lib/routing';
import { site } from '@/lib/site';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  hideLanguage?: boolean;
  jsonLd?: Record<string, unknown>;
  bodyClass?: string;
}

const {
  lang,
  title,
  description,
  image,
  noindex = false,
  hideLanguage = false,
  jsonLd,
  bodyClass = '',
} = Astro.props;

const copy = t(lang);
const pageTitle = title && title !== copy.meta.siteTitle ? copy.meta.titleTemplate.replace('%s', title) : copy.meta.siteTitle;
const pageDescription = description ?? copy.meta.description;

const path = stripBase(Astro.url.pathname);
const neutralPath =
  path === '/en' || path === '/en/' ? '/' : path.startsWith('/en/') ? path.slice(3) : path;
const canonical = new URL(localizedHref(neutralPath, lang), Astro.site);
const zhUrl = new URL(localizedHref(neutralPath, 'zh'), Astro.site);
const enUrl = new URL(localizedHref(neutralPath, 'en'), Astro.site);
const defaultImage = new URL(href('/og/default.png'), Astro.site);
const ogImage = image
  ? new URL(image.startsWith('http') ? image : href(image), Astro.site)
  : defaultImage;

const websiteLd = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: copy.meta.siteTitle,
  url: new URL(localizedHref('/', lang), Astro.site).toString(),
  description: copy.meta.description,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  sameAs: [site.github, site.blog],
};
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl.toString()} />
    <link rel="alternate" hreflang="en" href={enUrl.toString()} />
    <link rel="alternate" hreflang="x-default" href={zhUrl.toString()} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.meta.siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.toString()} />

    <meta name="theme-color" content="#f3efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="apple-touch-icon" href={href('/favicon.svg')} />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const key = 'android-kit-theme';
          const stored = localStorage.getItem(key);
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} showLanguage={!hideLanguage} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const themeKey = 'android-kit-theme';

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(themeKey, next);
        } catch {
          /* storage is optional */
        }
      });

      document.addEventListener('click', async (event) => {
        const target = event.target as HTMLElement | null;
        const button = target?.closest<HTMLElement>('[data-copy]');
        if (!button) return;

        const value = button.dataset.copy ?? '';
        const label = button.querySelector<HTMLElement>('[data-copy-label]');
        const original = label?.textContent ?? '';

        try {
          await navigator.clipboard.writeText(value);
        } catch {
          return;
        }

        if (label) label.textContent = button.dataset.copiedLabel ?? original;
        button.dataset.copied = 'true';
        window.setTimeout(() => {
          if (label) label.textContent = original;
          button.dataset.copied = 'false';
        }, 1600);
      });

      document.querySelectorAll('#mobile-menu a').forEach((anchor) => {
        anchor.addEventListener('click', () => {
          const menu = document.getElementById('mobile-menu');
          if (menu instanceof HTMLDetailsElement) menu.open = false;
        });
      });

      const reveal = () => {
        const items = document.querySelectorAll<HTMLElement>('.reveal');
        if (!('IntersectionObserver' in window)) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((item) => observer.observe(item));
      };

      reveal();
    </script>
  </body>
</html>
