---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentCard from '@/components/ComponentCard.astro';
import Icon from '@/components/Icon.astro';
import { archive, components, type Category } from '@/data/registry';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const filters: Category[] = ['i18n', 'state', 'logging', 'architecture', 'webview'];

const searchText = (slug: string) => {
  const component = components.find((entry) => entry.slug === slug);
  if (!component) return '';
  return [
    component.name,
    component.part,
    component.artifact ?? '',
    component.tagline[lang],
    component.summary[lang],
    ...component.categories.map((category) => copy.categories[category]),
    ...component.platforms.map((platform) => copy.platforms[platform]),
  ]
    .join(' ')
    .toLowerCase();
};
---

<BaseLayout
  lang={lang}
  title={copy.components.title}
  description={copy.components.lead}
  image="/og/default.png"
>
  <section class="border-b border-line">
    <div class="wrap grid gap-8 py-16 md:grid-cols-[1fr_auto] md:items-end md:py-20">
      <div>
        <p class="label">01 / {copy.nav.components}</p>
        <h1 class="display mt-4 text-[clamp(3rem,7vw,5.6rem)]">{copy.components.title}</h1>
        <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted">
          {copy.components.lead}
        </p>
      </div>
      <div class="flex items-end gap-6 md:flex-col md:items-end md:gap-2">
        <span class="display text-[4rem] leading-none">{String(components.length).padStart(2, '0')}</span>
        <span class="label pb-2">{copy.components.count}</span>
      </div>
    </div>
  </section>

  <section class="wrap py-10 md:py-14">
    <div class="flex flex-col gap-4 border-y border-line py-3 lg:flex-row lg:items-center">
      <label class="relative flex-1">
        <span class="sr-only">{copy.common.search}</span>
        <Icon
          name="search"
          size={14}
          class="pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 text-muted"
        />
        <input
          id="component-search"
          type="search"
          class="w-full border-0 bg-transparent py-2 pl-8 pr-2 text-[13px] text-ink outline-none placeholder:text-muted/80"
          placeholder={copy.components.searchPlaceholder}
          autocomplete="off"
        />
      </label>

      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label={copy.common.category}>
        <button type="button" class="filter-chip is-active" data-filter="all">{copy.common.all}</button>
        {
          filters.map((filter) => (
            <button type="button" class="filter-chip" data-filter={filter}>
              {copy.categories[filter]}
            </button>
          ))
        }
      </div>

      <span
        class="mono shrink-0 text-[10px] uppercase tracking-[0.07em] text-muted"
        id="component-count"
        data-label={copy.components.count}
      >
        {String(components.length).padStart(2, '0')} {copy.components.count}
      </span>
    </div>

    <div id="component-grid" class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        components.map((component, index) => (
          <div
            class="component-item reveal"
            data-search={searchText(component.slug)}
            data-categories={component.categories.join(' ')}
            style={`transition-delay: ${Math.min(index * 50, 250)}ms`}
          >
            <ComponentCard component={component} lang={lang} />
          </div>
        ))
      }
    </div>

    <p id="component-empty" class="hidden border border-line bg-surface p-8 text-sm text-muted">
      {copy.components.empty}
    </p>
  </section>

  <section class="border-t border-line bg-surface/40">
    <div class="wrap py-16 md:py-20">
      <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:items-end">
        <div>
          <p class="label">02 / Archive</p>
          <h2 class="display mt-3 text-[clamp(2rem,4vw,3.2rem)]">{copy.components.archiveTitle}</h2>
        </div>
        <div>
          <p class="max-w-xl text-[14px] leading-relaxed text-muted">{copy.components.archiveLead}</p>
          <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.06em] text-muted">
            {copy.components.archiveNote}
          </p>
        </div>
      </div>

      <div class="mt-8 border-t border-line">
        {
          archive.map((entry) => (
            <a
              href={`https://github.com/${entry.repo}`}
              target="_blank"
              rel="noreferrer noopener"
              class="group grid gap-2 border-b border-line py-5 transition-colors hover:bg-surface md:grid-cols-[1.1fr_2fr_0.45fr_0.5fr] md:items-center md:gap-6"
            >
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold group-hover:text-accent">{entry.name}</span>
                <Icon
                  name="arrow-up-right"
                  size={12}
                  class="text-muted opacity-0 transition-opacity group-hover:opacity-100"
                />
              </div>
              <p class="text-[12.5px] leading-relaxed text-muted">{entry.description[lang]}</p>
              <span class="mono text-[10px] uppercase tracking-[0.06em] text-muted">{entry.language}</span>
              <span class="mono text-[10px] uppercase tracking-[0.06em] text-muted md:text-right">
                {entry.updatedAt}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>('#component-search');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.component-item'));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
    const count = document.querySelector<HTMLElement>('#component-count');
    const empty = document.querySelector<HTMLElement>('#component-empty');

    let activeFilter = 'all';

    function apply() {
      const query = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;

      for (const item of items) {
        const matchesText = !query || (item.dataset.search ?? '').includes(query);
        const matchesCategory =
          activeFilter === 'all' ||
          (item.dataset.categories ?? '').split(' ').includes(activeFilter);
        const show = matchesText && matchesCategory;
        item.hidden = !show;
        if (show) visible += 1;
      }

      if (count) {
        count.textContent = `${String(visible).padStart(2, '0')} ${count.dataset.label ?? ''}`.trim();
      }
      if (empty) empty.hidden = visible > 0;
    }

    input?.addEventListener('input', apply);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeFilter = chip.dataset.filter ?? 'all';
        for (const other of chips) other.classList.toggle('is-active', other === chip);
        apply();
      });
    }
  </script>
</BaseLayout>
