---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/lib/site';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const about = copy.about;
---

<BaseLayout
  lang={lang}
  title={about.title}
  description={about.lead}
  image="/og/default.png"
>
  <section class="border-b border-line">
    <div class="grid-bg pointer-events-none absolute inset-x-0 top-16 -z-10 h-72 opacity-50"></div>
    <div class="wrap grid gap-10 py-16 md:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
      <div>
        <p class="label">05 / {about.title}</p>
        <h1 class="display mt-4 text-[clamp(3rem,7vw,5.8rem)]">{about.title}</h1>
        <p class="mt-5 max-w-xl text-[18px] leading-relaxed text-ink/80">{about.lead}</p>
      </div>

      <div class="border border-line bg-surface p-5 md:p-6">
        <p class="label">{about.focusTitle}</p>
        <ul class="mt-3 grid gap-2">
          {
            about.focus.map((item, index) => (
              <li class="flex items-baseline gap-3 border-b border-line/70 pb-2 last:border-0 last:pb-0">
                <span class="part-no">{String(index + 1).padStart(2, '0')}</span>
                <span class="text-[13px] text-ink/85">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap grid gap-12 py-16 md:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
    <div class="space-y-5 text-[15.5px] leading-[1.9] text-muted">
      <p>{about.bio1}</p>
      <p>{about.bio2}</p>
      <p class:list={['border-l-2 border-accent pl-4 font-serif text-[1.35rem] leading-snug text-ink', lang === 'en' && 'italic']}>
        {copy.footer.note}
      </p>
    </div>

    <aside class="border border-line bg-surface p-6">
      <p class="label">{about.links}</p>
      <div class="mt-4 divide-y divide-line">
        <a
          class="group flex items-center justify-between gap-4 py-3 first:pt-0"
          href={site.github}
          target="_blank"
          rel="noreferrer noopener"
        >
          <span>
            <span class="block text-sm font-semibold group-hover:text-hover">{about.github}</span>
            <span class="mono mt-0.5 block text-[10px] text-muted">github.com/xechoz</span>
          </span>
          <Icon name="arrow-up-right" size={14} class="text-muted group-hover:text-hover" />
        </a>
        <a
          class="group flex items-center justify-between gap-4 py-3"
          href={site.blog}
          target="_blank"
          rel="noreferrer noopener"
        >
          <span>
            <span class="block text-sm font-semibold group-hover:text-hover">{about.blog}</span>
            <span class="mono mt-0.5 block text-[10px] text-muted">xechoz.github.io</span>
          </span>
          <Icon name="arrow-up-right" size={14} class="text-muted group-hover:text-hover" />
        </a>
        <a
          class="group flex items-center justify-between gap-4 py-3"
          href={site.quickFileShare}
          target="_blank"
          rel="noreferrer noopener"
        >
          <span>
            <span class="block text-sm font-semibold group-hover:text-hover">{about.quickFileShare}</span>
            <span class="mono mt-0.5 block text-[10px] text-muted">Compose Multiplatform</span>
          </span>
          <Icon name="arrow-up-right" size={14} class="text-muted group-hover:text-hover" />
        </a>
        <a
          class="group flex items-center justify-between gap-4 py-3 last:pb-0"
          href={site.repo}
          target="_blank"
          rel="noreferrer noopener"
        >
          <span>
            <span class="block text-sm font-semibold group-hover:text-hover">{about.siteSource}</span>
            <span class="mono mt-0.5 block text-[10px] text-muted">xechoz/android-kit</span>
          </span>
          <Icon name="arrow-up-right" size={14} class="text-muted group-hover:text-hover" />
        </a>
      </div>
      <p class="mt-5 border-t border-line pt-4 text-[11px] leading-relaxed text-muted">
        {about.siteNote}
      </p>
    </aside>
  </section>

  <section class="border-y border-line bg-surface/40">
    <div class="wrap py-16 md:py-20">
      <p class="label">06 / {about.principlesTitle}</p>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          about.principles.map((principle, index) => (
            <div class="border-t border-line pt-4">
              <span class="part-no">{String(index + 1).padStart(2, '0')}</span>
              <h2 class="mt-3 text-lg font-semibold tracking-[-0.01em]">{principle.title}</h2>
              <p class="mt-2 text-[13px] leading-relaxed text-muted">{principle.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap py-16 md:py-20">
    <div class="grid gap-6 md:grid-cols-[0.7fr_1.3fr] md:items-center">
      <div>
        <p class="label">{about.selectedWork}</p>
        <h2 class="display mt-3 text-[clamp(2rem,4vw,3.2rem)]">{about.quickFileShare}</h2>
      </div>
      <a
        class="group border border-line bg-surface p-6 transition-colors hover:border-hover/40 md:p-8"
        href={site.quickFileShare}
        target="_blank"
        rel="noreferrer noopener"
      >
        <div class="flex items-start justify-between gap-6">
          <p class="max-w-xl text-[14px] leading-relaxed text-muted">{about.quickFileShareDesc}</p>
          <Icon name="arrow-up-right" size={18} class="mt-1 shrink-0 text-muted group-hover:text-hover" />
        </div>
        <div class="mt-5 flex flex-wrap gap-1.5 border-t border-line pt-4">
          <span class="tag">Android</span>
          <span class="tag">Desktop</span>
          <span class="tag">Compose Multiplatform</span>
          <span class="tag">Kotlin</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
