---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComponentCard from '@/components/ComponentCard.astro';
import CopyButton from '@/components/CopyButton.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { components, stats } from '@/data/registry';
import { localizedHref } from '@/lib/routing';
import { site } from '@/lib/site';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const lead = components[0];
const pad = (value: number) => String(value).padStart(2, '0');

const install = site.skillsInstall;

const terminal = `$ npx skills add xechoz/android-kit

  ✓ 6 skills installed

  $ your-agent "add language switching"

  → reading locale-kit/SKILL.md
  → adding io.github.xechoz:locale:1.0.0
  → wiring locales_config.xml
  → ./gradlew :app:assembleDebug`;

const skillExcerpt = `---
name: locale-kit
description: Integrate LocaleKit for in-app
  language switching on Android.
metadata:
  artifact: io.github.xechoz:locale
  version: 1.0.0
---

## Steps
1. Add the dependency
2. Declare locales_config.xml
3. Extend AppCompatActivity
4. Build the picker

## Verify
./gradlew :app:assembleDebug`;

const tree = `playground/
├── app/
│   └── src/main/java/…/
│       ├── MainActivity.kt
│       └── demo/
│           ├── LocaleDemo.kt
│           └── MvsDemo.kt
├── skills/
│   ├── locale-kit/SKILL.md
│   └── mvs/SKILL.md
├── TASK.md
└── settings.gradle.kts`;
---

<BaseLayout lang={lang}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10 opacity-60"></div>

    <div class="wrap grid gap-14 py-16 lg:grid-cols-[1.12fr_0.88fr] lg:items-center lg:gap-16 lg:py-24">
      <div class="reveal">
        <p class="label">{copy.home.eyebrow}</p>

        <h1 class="display mt-6 text-[clamp(3.35rem,8.2vw,6.6rem)]">
          <span class="block">{copy.home.titleA}</span>
          <span class:list={['mt-1 block text-accent', lang === 'en' && 'italic']}>{copy.home.titleB}</span>
        </h1>

        <p class="mt-7 max-w-xl text-[16px] leading-relaxed text-muted">
          {copy.home.lead}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn--primary" href={localizedHref('/components/', lang)}>
            {copy.home.ctaComponents}
            <Icon name="arrow-right" size={14} />
          </a>
          <a class="btn btn--ghost" href={localizedHref('/builder/', lang)}>
            {copy.home.ctaBuilder}
            <Icon name="code" size={14} />
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10.5px] uppercase tracking-[0.08em] text-muted">
          <span><strong class="font-medium text-ink">{pad(stats.libraries)}</strong> {copy.home.statsLibraries}</span>
          <span class="hidden h-3 w-px bg-line sm:block"></span>
          <span><strong class="font-medium text-ink">{pad(stats.skills)}</strong> {copy.home.statsSkills}</span>
          <span class="hidden h-3 w-px bg-line sm:block"></span>
          <span><strong class="font-medium text-ink">{pad(stats.demos)}</strong> {copy.home.statsDemos}</span>
        </div>
      </div>

      <div class="reveal flex flex-col gap-4" style="transition-delay: 90ms">
        <div class="border border-line bg-surface p-5">
          <div class="flex items-center justify-between gap-4">
            <span class="part-no">{lead.part}</span>
            <StatusBadge status={lead.status} lang={lang} />
          </div>

          <div class="mt-6 flex items-end justify-between gap-4">
            <h2 class="font-sans text-2xl font-semibold tracking-[-0.02em]">{lead.name}</h2>
            <span class="mono text-[10.5px] uppercase tracking-[0.06em] text-muted">v{lead.version}</span>
          </div>

          <p class="mt-2 text-[13.5px] leading-relaxed text-muted">{lead.tagline[lang]}</p>

          <div class="mt-5 border-t border-line pt-3">
            <div class="flex items-center justify-between gap-3">
              <code class="mono truncate text-[10.5px] text-ink/80">{lead.artifact}</code>
              <CopyButton
                value={lead.artifact ?? ''}
                label={copy.common.copy}
                copiedLabel={copy.common.copied}
                variant="light"
                icon={false}
              />
            </div>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10px] uppercase tracking-[0.06em] text-muted">
              <span>minSdk {lead.minSdk}</span>
              <span>{lead.platforms.map((platform) => copy.platforms[platform]).join(' / ')}</span>
              <span>{lead.license}</span>
            </div>
          </div>
        </div>

        <div class="code-shell">
          <div class="code-shell__bar">
            <Icon name="terminal" size={12} />
            terminal
            <span class="ml-auto">agent skills</span>
          </div>
          <pre><code>{terminal}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="wrap grid grid-cols-3 divide-x divide-line">
      <div class="py-7 pr-5 md:py-9">
        <div class="display text-[2.4rem] md:text-[3.2rem]">{pad(stats.libraries)}</div>
        <div class="label mt-2">{copy.home.statsLibraries}</div>
      </div>
      <div class="px-5 py-7 md:py-9">
        <div class="display text-[2.4rem] md:text-[3.2rem]">{pad(stats.skills)}</div>
        <div class="label mt-2">{copy.home.statsSkills}</div>
      </div>
      <div class="py-7 pl-5 md:py-9">
        <div class="display text-[2.4rem] md:text-[3.2rem]">{pad(stats.demos)}</div>
        <div class="label mt-2">{copy.home.statsDemos}</div>
      </div>
    </div>
  </section>

  <section class="wrap pb-20 pt-20 md:pb-28 md:pt-28">
    <div class="reveal">
      <SectionHeading
        eyebrow={copy.home.featuredEyebrow}
        title={copy.home.featuredTitle}
        lead={copy.home.featuredLead}
      >
        <a
          slot="action"
          class="btn btn--ghost btn--sm"
          href={localizedHref('/components/', lang)}
        >
          {copy.home.allComponents}
          <Icon name="arrow-right" size={13} />
        </a>
      </SectionHeading>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        components.map((component, index) => (
          <div class="reveal" style={`transition-delay: ${index * 50}ms`}>
            <ComponentCard component={component} lang={lang} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line bg-surface/50">
    <div class="wrap grid gap-12 py-20 md:py-28 lg:grid-cols-[0.92fr_1.08fr]">
      <div class="reveal">
        <p class="label">{copy.home.skillsEyebrow}</p>
        <h2 class="display mt-3 max-w-lg text-[clamp(2rem,4vw,3.4rem)]">
          {copy.home.skillsTitle}
        </h2>
        <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-muted">
          {copy.home.skillsLead}
        </p>

        <div class="mt-8 grid gap-5 sm:grid-cols-3">
          <div>
            <span class="part-no">01</span>
            <h3 class="mt-2 text-sm font-semibold">{copy.home.skillsStep1Title}</h3>
            <p class="mt-1.5 text-[12.5px] leading-relaxed text-muted">
              {copy.home.skillsStep1Body}
            </p>
          </div>
          <div>
            <span class="part-no">02</span>
            <h3 class="mt-2 text-sm font-semibold">{copy.home.skillsStep2Title}</h3>
            <p class="mt-1.5 text-[12.5px] leading-relaxed text-muted">
              {copy.home.skillsStep2Body}
            </p>
          </div>
          <div>
            <span class="part-no">03</span>
            <h3 class="mt-2 text-sm font-semibold">{copy.home.skillsStep3Title}</h3>
            <p class="mt-1.5 text-[12.5px] leading-relaxed text-muted">
              {copy.home.skillsStep3Body}
            </p>
          </div>
        </div>

        <a class="btn btn--ghost mt-8" href={localizedHref('/skills/', lang)}>
          {copy.home.skillsCta}
          <Icon name="arrow-right" size={13} />
        </a>
      </div>

      <div class="reveal self-start" style="transition-delay: 90ms">
        <div class="code-shell">
          <div class="code-shell__bar">
            <Icon name="code" size={12} />
            skills/locale-kit/SKILL.md
            <span class="ml-auto normal-case tracking-normal">agent skills</span>
          </div>
          <pre class="max-h-[420px]"><code>{skillExcerpt}</code></pre>
          <div class="flex items-center justify-between gap-3 border-t border-white/10 p-3">
            <code class="mono truncate text-[10.5px] text-code-muted">{install}</code>
            <CopyButton
              value={install}
              label={copy.common.copy}
              copiedLabel={copy.common.copied}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap py-20 md:py-28">
    <div class="reveal border border-line bg-surface">
      <div class="grid lg:grid-cols-[1fr_0.86fr]">
        <div class="p-7 md:p-10">
          <p class="label">{copy.home.builderEyebrow}</p>
          <h2 class="display mt-3 max-w-md text-[clamp(2rem,4vw,3.3rem)]">
            {copy.home.builderTitle}
          </h2>
          <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-muted">
            {copy.home.builderLead}
          </p>
          <a class="btn btn--primary mt-8" href={localizedHref('/builder/', lang)}>
            {copy.home.builderCta}
            <Icon name="arrow-right" size={13} />
          </a>
        </div>

        <div class="border-t border-line bg-surface-2/40 p-6 md:p-8 lg:border-l lg:border-t-0">
          <div class="flex items-center justify-between">
            <span class="label">Selected</span>
            <span class="mono text-[10px] uppercase tracking-[0.06em] text-muted">02</span>
          </div>
          <div class="mt-3 flex flex-wrap gap-1.5">
            <span class="tag !border-ink/30 !text-ink">LocaleKit</span>
            <span class="tag !border-ink/30 !text-ink">MVS</span>
          </div>

          <div class="my-5 flex items-center gap-2 text-muted">
            <Icon name="chevron-down" size={14} />
            <span class="mono text-[10px] uppercase tracking-[0.08em]">generate</span>
            <span class="h-px flex-1 bg-line"></span>
          </div>

          <pre class="mono overflow-x-auto text-[11px] leading-[1.9] text-muted">{tree}</pre>

          <div class="mt-5 flex flex-wrap gap-1.5 border-t border-line pt-4">
            <span class="tag">gradle wrapper</span>
            <span class="tag">Compose M3</span>
            <span class="tag">skills/</span>
            <span class="tag">TASK.md</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap grid gap-10 border-t border-line py-16 md:grid-cols-[0.8fr_1.2fr] md:py-20">
    <div class="reveal">
      <p class="label">{copy.home.notesEyebrow}</p>
      <h2 class="display mt-3 text-[clamp(1.9rem,3.4vw,2.8rem)]">{copy.home.notesTitle}</h2>
    </div>
    <div class="reveal" style="transition-delay: 70ms">
      <p class="max-w-xl text-[16px] leading-relaxed text-muted">{copy.home.notesBody}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn--ghost btn--sm" href={site.blog} target="_blank" rel="noreferrer noopener">
          {copy.home.notesBlog}
          <Icon name="external-link" size={12} />
        </a>
        <a class="btn btn--ghost btn--sm" href={site.repo} target="_blank" rel="noreferrer noopener">
          {copy.home.notesGithub}
          <Icon name="github" size={12} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
